# ─────────────────────────────────────────────────────────────
# NEXUS RAG — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# ── LLM Provider ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Vector Database (Qdrant) ──────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=nexus_knowledge

# ── Knowledge Graph (Neo4j) ───────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexus_password

# ── Relational Database (PostgreSQL) ──────────────────────────
POSTGRES_DSN=postgresql://nexus:nexus_password@localhost:5432/nexus

# ── Cache (Redis) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Streaming (Kafka) ────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=nexus-stream

# ── Security ──────────────────────────────────────────────────
SIGNING_KEY=<32-byte-hex-for-deletion-certificates>
API_KEY=nexus-dev-key

# ── Monitoring (LangSmith) ────────────────────────────────────
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=nexus-rag-v1
LANGSMITH_TRACING=true

# ── Model Configuration ──────────────────────────────────────
TEXT_EMBEDDING_MODEL=intfloat/e5-large-v2
MULTILINGUAL_EMBEDDING_MODEL=intfloat/multilingual-e5-large
CODE_EMBEDDING_MODEL=microsoft/codebert-base
TABLE_MODEL=google/tapas-base
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
NLI_MODEL=cross-encoder/nli-deberta-v3-small
WHISPER_MODEL=base
CLIP_MODEL=ViT-L/14
LLM_MODEL=claude-sonnet-4-6

# ── Pipeline Tuning ──────────────────────────────────────────
FINE_TUNE_EVERY_N_QUERIES=1000
EPISTEMIC_EPSILON=0.15
EPISTEMIC_MAX_ENTROPY=0.85
SEMANTIC_CACHE_THRESHOLD=0.92
STREAMING_BATCH_MS=50
STREAMING_FRESHNESS_HOURS=24
CONTRADICTION_THRESHOLD=0.70
EMBEDDING_DIM=1024

# ── Server ────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
DEBUG=false
